# --- Telegram ---
# Отримати у @BotFather
BOT_TOKEN=

# Telegram chat_id менеджерів, які отримують сповіщення та звіти.
# Дізнатись chat_id: написати боту @userinfobot і скопіювати Id.
# Кілька ID — через кому.
MANAGER_CHAT_IDS=

# --- OneDrive/SharePoint (Microsoft Graph, необов'язково для першого запуску) ---
# Якщо ці поля порожні — бот працює повністю локально (data/),
# файли просто не будуть додатково копіюватись у хмару.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Посилання "Поділитися" на вашу папку OneDrive/SharePoint — просто вставте
# сюди звичайне посилання з браузера. Бот сам визначить, де саме лежить
# папка, і щодня створюватиме в ній підпапку з датою (YYYY-MM-DD).
MS_SHARE_URL=
